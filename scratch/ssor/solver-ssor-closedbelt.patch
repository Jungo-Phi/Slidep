+  const loopRoots = new Set<string>();
+  links.forEach((link, i) => {
+    const conditioning =
+      (link.type === "BeltSubChainAggregate" || link.type === "BeltSegmentNoSlip") &&
+      link.closed;
+    if (conditioning && freeKeys[i].length > 0)
+      loopRoots.add(find(freeKeys[i][0]));
+  });
+
+  const alternateKeys = new Set<string>();
+  for (const key of parent.keys())
+    if (!loopRoots.has(find(key))) alternateKeys.add(key);
+
+  links.forEach((link, i) => {
+    const free = freeKeys[i];
+    if (free.length > 0 && !loopRoots.has(find(free[0])))
+      (link as Record<string, unknown>).ssorAlternate = true;
+  });
+
+  return alternateKeys;
+}
