+  if (SSOR_MODE === "off") return null;
+  const n = links.length;
+  const order = new Int32Array(n);
+  if (SSOR_MODE === "all") {
+    for (let i = 0; i < n; i++) order[i] = n - 1 - i;
+    return order;
+  }
+  const free: number[] = [];
+  for (let i = 0; i < n; i++) if (!ssor_pinned(links[i])) free.push(i);
+  let k = free.length - 1;
+  for (let i = 0; i < n; i++) order[i] = ssor_pinned(links[i]) ? i : free[k--];
+  return order;
+}
