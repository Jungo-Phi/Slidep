+ * import — see the patch's own note on why `analysis-model.ts` cannot be reached from
+ * the solver). The key set is carried further, on `SimulationModel.ssorAlternateKeys`,
+ * so a link built fresh every frame/substep from a KNOWN model key — a beam's
+ * dynamics-only midpoint `FixedOnSegment`, chiefly — can still be classified without
+ * re-running this (a HandleGrab/collision link touches no model key and is left
+ * untagged: not alternated, i.e. fixed order — conservative). A belt that disconnects
+ * mid-run keeps its chain pinned even once it has actually opened up, until the next
+ * full compile. To be removed once measured, alongside solver-ssor.patch. */
+function tag_ssor_alternate_links(nodes: KinNodes, links: Link[]): Set<string> {
+  const isFree = (key: string) =>
+    (nodes.positions.has(key) && nodes.posMasses.get(key) !== 0) ||
+    nodes.angles.has(key);
+
+  const parent = new Map<string, string>();
+  const add = (key: string) => {
+    if (!parent.has(key)) parent.set(key, key);
+  };
+  const find = (key: string): string => {
+    let root = key;
+    while (parent.get(root) !== root) root = parent.get(root)!;
+    let walk = key;
+    while (parent.get(walk) !== root) {
+      const next = parent.get(walk)!;
+      parent.set(walk, root);
+      walk = next;
+    }
+    return root;
+  };
+  const union = (a: string, b: string) => {
+    add(a);
+    add(b);
+    const ra = find(a);
+    const rb = find(b);
+    if (ra !== rb) parent.set(ra, rb);
+  };
+
+  const freeKeys = links.map((link) => keys_of(link).filter(isFree));
+  freeKeys.forEach((free) => {
+    free.forEach(add);
+    for (let i = 1; i < free.length; i++) union(free[0], free[i]);
+  });
