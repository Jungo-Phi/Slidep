+/* ── TEMPORARY EXPERIMENT: symmetric Gauss-Seidel sweep order ────────────────
+ * Off unless SLIDEP_SSOR is set. "all" alternates every link; "nobelt" alternates
+ * everything except the belt's deliberately redundant conditioning set, which keeps its
+ * own slots and its own forward relative order; "perchain" alternates a link only when
+ * its whole kinematic chain is tree-shaped (no closed-belt machinery anywhere in it —
+ * see `tag_ssor_tree_links` in simulation-engine.ts, which is what sets `ssorTree` on
+ * the link objects this reads). To be removed once measured. */
+const SSOR_MODE: string =
+  (globalThis as { process?: { env?: Record<string, string | undefined> } }).process?.env
+    ?.SLIDEP_SSOR ?? "off";
+
+const BELT_MACHINERY = new Set([
+  "BeltLength",
+  "BeltPin",
+  "BeltJunction",
+  "BeltSegmentNoSlip",
+  "BeltSubChainAggregate",
+  "BeltFollowsTangent",
+]);
+
+function ssor_pinned(link: Link): boolean {
+  if (SSOR_MODE === "beltall") return BELT_MACHINERY.has(link.type);
+  if (SSOR_MODE === "perchain")
+    return !(link as Record<string, unknown>).ssorTree;
+  return (
+    link.type === "BeltSubChainAggregate" ||
+    (link.type === "BeltSegmentNoSlip" && link.closed)
+  );
+}
+
+function ssor_reverse_order(links: Link[]): Int32Array | null {
+  if (SSOR_MODE === "off") return null;
+  const n = links.length;
+  const order = new Int32Array(n);
+  if (SSOR_MODE === "all") {
+    for (let i = 0; i < n; i++) order[i] = n - 1 - i;
+    return order;
+  }
+  const free: number[] = [];
+  for (let i = 0; i < n; i++) if (!ssor_pinned(links[i])) free.push(i);
+  let k = free.length - 1;
+  for (let i = 0; i < n; i++) order[i] = ssor_pinned(links[i]) ? i : free[k--];
+  return order;
+}
