+/* ── TEMPORARY EXPERIMENT: per-chain SSOR classification ──────────────────────
+ * Returns the free variable keys that sit in a connected component with no closed-belt
+ * machinery anywhere in it — the redundant set `analysis-model.ts`'s
+ * `closed_loop_surplus`/`BeltSubChainAggregate` pruning also targets. Also tags every
+ * compiled link touching one of those keys with `ssorTree = true`, which is what
+ * `PBD_kinematic_solver.ts`'s SSOR prototype reads directly off the link object (no
+ * import — see the patch's own note on why `analysis-model.ts` cannot be reached from
+ * the solver). The key set is carried further, on `SimulationModel.ssorTreeKeys`, so a
+ * link built fresh every frame/substep from a KNOWN model key — a beam's dynamics-only
+ * midpoint `FixedOnSegment`, chiefly — can still be classified without re-running this
+ * (a HandleGrab/collision link touches no model key and is left untagged: NOT tree, i.e.
+ * fixed order — conservative). A belt that disconnects mid-run keeps its chain pinned
+ * even once it has actually become a tree, until the next full compile. To be removed
+ * once measured, alongside solver-ssor.patch. */
+function tag_ssor_tree_links(nodes: KinNodes, links: Link[]): Set<string> {
+  const isFree = (key: string) =>
+    (nodes.positions.has(key) && nodes.posMasses.get(key) !== 0) ||
+    nodes.angles.has(key);
+
+  const parent = new Map<string, string>();
+  const add = (key: string) => {
+    if (!parent.has(key)) parent.set(key, key);
+  };
+  const find = (key: string): string => {
+    let root = key;
+    while (parent.get(root) !== root) root = parent.get(root)!;
+    let walk = key;
+    while (parent.get(walk) !== root) {
+      const next = parent.get(walk)!;
+      parent.set(walk, root);
+      walk = next;
+    }
+    return root;
+  };
+  const union = (a: string, b: string) => {
+    add(a);
+    add(b);
+    const ra = find(a);
+    const rb = find(b);
+    if (ra !== rb) parent.set(ra, rb);
+  };
+
+  const freeKeys = links.map((link) => keys_of(link).filter(isFree));
+  freeKeys.forEach((free) => {
+    free.forEach(add);
+    for (let i = 1; i < free.length; i++) union(free[0], free[i]);
+  });
+
+  const loopRoots = new Set<string>();
+  links.forEach((link, i) => {
+    const conditioning =
+      link.type === "BeltSubChainAggregate" ||
+      (link.type === "BeltSegmentNoSlip" && link.closed);
+    if (conditioning && freeKeys[i].length > 0)
+      loopRoots.add(find(freeKeys[i][0]));
+  });
+
+  const treeKeys = new Set<string>();
+  for (const key of parent.keys()) if (!loopRoots.has(find(key))) treeKeys.add(key);
+
+  links.forEach((link, i) => {
+    const free = freeKeys[i];
+    if (free.length > 0 && !loopRoots.has(find(free[0])))
+      (link as Record<string, unknown>).ssorTree = true;
+  });
+
+  return treeKeys;
+}
